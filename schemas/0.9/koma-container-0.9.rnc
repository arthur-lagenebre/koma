# KOMA 0.9 — schema for META-INF/container.xml
# Layer 2 only. Cross-document and resource constraints are out of scope.

default namespace = "urn:koma:container"
datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = Container

Container =
  element Container {
    attribute version { "0.9" },
    element RootFiles {
      element RootFile {
        attribute full-path { "koma/manifest.xml" },
        attribute media-type { "application/vnd.koma.manifest+xml" }
      }
    }
  }
